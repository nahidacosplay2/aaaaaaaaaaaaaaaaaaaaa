<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:clipToPadding="false"
    android:paddingStart="18dp"
    android:paddingTop="18dp"
    android:paddingEnd="18dp"
    android:paddingBottom="24dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif-black"
            android:text="@string/socks_settings_title"
            android:textColor="@color/on_surface"
            android:textSize="24sp" />

        <TextView
            style="@style/Card"
            android:layout_marginTop="12dp"
            android:text="@string/socks_settings_intro"
            android:textColor="@color/muted"
            android:textSize="13sp" />

        <LinearLayout
            style="@style/Card"
            android:layout_marginTop="12dp">

            <TextView style="@style/SettingsLabel" android:text="@string/socks_host_label" />
            <EditText
                android:id="@+id/socks_host"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="6dp"
                android:background="@drawable/bg_input"
                android:hint="@string/socks_host_hint"
                android:inputType="textUri"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:singleLine="true"
                android:textColor="@color/on_surface"
                android:textColorHint="@color/muted" />

            <TextView style="@style/SettingsLabel" android:text="@string/socks_port_label" />
            <EditText
                android:id="@+id/socks_port"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="6dp"
                android:background="@drawable/bg_input"
                android:inputType="number"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:singleLine="true"
                android:textColor="@color/on_surface"
                android:textColorHint="@color/muted" />

            <TextView style="@style/SettingsLabel" android:text="@string/socks_username_label" />
            <EditText
                android:id="@+id/socks_username"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="6dp"
                android:background="@drawable/bg_input"
                android:inputType="textNoSuggestions"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:singleLine="true"
                android:textColor="@color/on_surface"
                android:textColorHint="@color/muted" />

            <TextView style="@style/SettingsLabel" android:text="@string/socks_password_label" />
            <EditText
                android:id="@+id/socks_password"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="6dp"
                android:background="@drawable/bg_input"
                android:inputType="textPassword"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:singleLine="true"
                android:textColor="@color/on_surface"
                android:textColorHint="@color/muted" />
        </LinearLayout>

        <LinearLayout
            style="@style/Card"
            android:layout_marginTop="12dp">

            <TextView style="@style/SectionTitle" android:text="@string/socks_excluded_app_title" />
            <TextView
                style="@style/SettingsHint"
                android:layout_marginTop="5dp"
                android:text="@string/socks_excluded_app_hint" />
            <TextView
                android:id="@+id/socks_excluded_app"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:padding="10dp"
                android:textColor="@color/on_surface"
                android:textSize="13sp" />
            <TextView
                android:id="@+id/socks_choose_app"
                style="@style/TonalButton"
                android:layout_width="match_parent"
                android:layout_marginTop="8dp"
                android:text="@string/socks_choose_app" />
        </LinearLayout>

        <TextView
            android:id="@+id/socks_test_status"
            style="@style/Muted"
            android:layout_marginTop="12dp"
            android:textSize="13sp"
            android:visibility="gone" />

        <TextView
            android:id="@+id/socks_test"
            style="@style/TonalButton"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="12dp"
            android:text="@string/socks_test" />

        <TextView
            android:id="@+id/socks_save"
            style="@style/TonalButton"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_button_primary"
            android:text="@string/socks_save"
            android:textColor="@color/on_accent" />
    </LinearLayout>
</ScrollView>
